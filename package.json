{
  "name": "chicago-public-data",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build && npm --prefix backend run build",
    "start": "node backend/dist/index.js",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix frontend run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
